===== Zadanie 2. Konfiguracja serwera i baza danych =====

$ cat /etc/krb5.conf /etc/krb5kdc/kdc.conf /etc/krb5kdc/kadm5.acl
[libdefaults]
        default_realm = REALM.KB.UWS.EDU.PL
        rdns = false
        dns_canonicalize_hostname = false

[realms]
        REALM.KB.UWS.EDU.PL = {
                kdc = kerberos.uws.edu.pl
                admin_server = kerberos.uws.edu.pl
        }

[domain_realm]
        kerberos.uws.edu.pl = REALM.KB.UWS.EDU.PL
[kdcdefaults]
    kdc_ports = 750,88

[realms]
    REALM.KB.UWS.EDU.PL = {
        database_name = /var/lib/krb5kdc/principal
        admin_keytab = FILE:/etc/krb5kdc/kadm5.keytab
        acl_file = /etc/krb5kdc/kadm5.acl
        key_stash_file = /etc/krb5kdc/stash
        kdc_ports = 750,88
        max_life = 10h 0m 0s
        max_renewable_life = 7d 0h 0m 0s
        master_key_type = aes256-cts
        supported_enctypes = aes256-cts:normal aes128-cts:normal
        default_principal_flags = +preauth
    }
*/admin@REALM.KB.UWS.EDU.PL *

$ kdb5_util create -r REALM.KB.UWS.EDU.PL -s -P masterpass123 2>&1 | tail -5
